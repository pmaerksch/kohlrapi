{
	"name": "pmaerksch/kohlrapi",
	"description": "Abstract base classes for Symfony API backends — generic CRUD, search, filter, and sort.",
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Philip Märksch"
		}
	],
	"require": {
		"php": ">=8.4",
		"psr/log": "^3.0",
		"symfony/framework-bundle": "^7.4 || ^8.0",
		"symfony/security-bundle": "^7.4 || ^8.0",
		"symfony/serializer": "^7.4 || ^8.0",
		"symfony/validator": "^7.4 || ^8.0",
		"symfony/http-foundation": "^7.4 || ^8.0",
		"symfony/http-kernel": "^7.4 || ^8.0",
		"symfony/uid": "^7.4 || ^8.0",
		"doctrine/dbal": "^4.0",
		"doctrine/orm": "^3.6.2",
		"doctrine/doctrine-bundle": "^3.2.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5 || ^12.0",
		"phpstan/phpstan": "^2.1",
		"symfony/property-access": "^7.4 || ^8.0",
		"symfony/property-info": "^7.4 || ^8.0"
	},
	"autoload": {
		"psr-4": {
			"pmaerksch\\Kohlrapi\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"pmaerksch\\Kohlrapi\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse"
	},
	"minimum-stability": "stable"
}
